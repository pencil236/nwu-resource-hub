APP_NAME=NWU Resource Hub
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://campus:campus@postgres:5432/campus
REDIS_URL=redis://redis:6379/0
ALLOWED_EMAIL_DOMAINS=stumail.nwu.edu.cn,nwu.edu.cn
ADMIN_EMAILS=admin@nwu.edu.cn
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_UPLOAD_MB=200
AI_PARSE_MAX_MB=50
USER_STORAGE_QUOTA_MB=500
AUTO_HIDE_REPORT_THRESHOLD=3
STORAGE_BACKEND=minio
LOCAL_STORAGE_PATH=./data/uploads
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=campus
MINIO_SECRET_KEY=campus-secret
MINIO_BUCKET=resources
MINIO_SECURE=false
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=campus-share@nwu.edu.cn
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
EMBEDDING_MODEL=BAAI/bge-m3
CLAMAV_HOST=
CLAMAV_PORT=3310
ENABLE_BACKGROUND_TASKS=true
CORS_ORIGINS=http://localhost:5173
